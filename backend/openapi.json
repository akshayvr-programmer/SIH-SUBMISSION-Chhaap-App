    "/v1/pricing/estimate": {
      "post": {
        "tags": [
          "pricing"
        ],
        "summary": "Estimate",
        "description": "Price from evidence: nearest comparables, a cost floor, and a season factor.\n\nContract note for the client: when confidence is `floor_only`, `comparables`\nwill be empty and the UI must present the number as a floor, not a market\nprice. Never render `recommended_inr` without the evidence beside it.",
        "operationId": "estimate_v1_pricing_estimate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PricingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/publish/{channel}": {
      "post": {
        "tags": [
          "publish"
        ],
        "summary": "Publish",
        "description": "Emit the catalog artifact for one channel.\n\nondc      -> Beckn-protocol catalog JSON\ngem       -> GeM bulk upload CSV\nwhatsapp  -> WhatsApp Business catalog item\nmicrosite -> public product page plus QR",
        "operationId": "publish_v1_publish__channel__post",
        "parameters": [
          {
            "name": "channel",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sync/outbox": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Sync Outbox",
        "description": "Accept a batch of products the phone created while offline.\n\nIdempotent on `client_id`. Replaying the same batch returns the same\nproduct ids and does not duplicate rows.",
        "operationId": "sync_outbox_v1_sync_outbox_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutboxRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
