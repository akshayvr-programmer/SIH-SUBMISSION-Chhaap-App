              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutboxResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Job Status",
        "description": "Poll enrichment progress for a synced product.",
        "operationId": "job_status_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
